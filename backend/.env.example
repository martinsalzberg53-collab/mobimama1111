# Copy to backend/.env for local development. Never commit the real .env.

# --- Email delivery (OTP) ---
# Provider order in users/email_utils.py is EmailJS -> Brevo -> Resend -> Gmail SMTP.
# Fill in at least one, otherwise nurse registration cannot send a code.

# EmailJS (sends through the Gmail account connected to the service)
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# Brevo (free tier, no custom domain needed)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Mobi Mama

# Resend
RESEND_API_KEY=
RESEND_FROM=Mobi Mama <onboarding@resend.dev>

# Gmail SMTP (needs a Google App Password, not the account password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Print OTPs to the console. Leave off outside development.
OTP_DEBUG_LOG=false

# --- Other services ---
GEMINI_API_KEY=
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=MobiMama

# --- Django ---
DJANGO_DEBUG=true
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
